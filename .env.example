# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Нейросеть для распознавания фото — заполните ОДИН из ключей.
# Без ключа бот работает, но размеры вводятся вручную.
# Бесплатно: ключ Google Gemini с https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Платно: ключ Claude API с https://console.anthropic.com (если задан, используется он)
ANTHROPIC_API_KEY=

# Необязательно: модели
# GEMINI_MODEL=gemini-flash-latest
# CLAUDE_MODEL=claude-opus-5

# Необязательно: Telegram ID пользователей через запятую, кому разрешён бот (пусто = всем)
ALLOWED_USERS=
